# ─────────────────────────────────────────────
# Sisigan Restaurant POS - Environment Config
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:yourpassword@localhost:3306/sisigan_pos"

# JWT Secret - change this to a long random string in production!
JWT_SECRET=sisigan_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=8h

# CORS - Flutter app origin (adjust for production)
CORS_ORIGIN=*
