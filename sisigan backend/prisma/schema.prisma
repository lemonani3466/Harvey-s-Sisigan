generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  address   String   @db.VarChar(255)
  city      String   @db.VarChar(100)
  contactNo String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  users     User[]
  authLogs  AuthLog[]
  inventory InventoryItem[]

  @@map("branches")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  role      Role     @default(CASHIER)
  branchId  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  branch    Branch   @relation(fields: [branchId], references: [id])
  authLogs  AuthLog[]
  inventoryAuditLogs InventoryAuditLog[] @relation("InventoryAuditActor")

  @@index([branchId])
  @@map("users")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  items     MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(150)
  description String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?     @db.VarChar(500)
  isAvailable Boolean     @default(true)
  categoryId  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  photo       Bytes?      @db.MediumBlob
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  recipes     MenuItemRecipeIngredient[]

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model Order {
  id           Int         @id @default(autoincrement())
  orderNumber  String      @unique @db.VarChar(30)
  status       OrderStatus @default(PENDING)
  type         OrderType   @default(DINE_IN)
  tableNumber  String?     @db.VarChar(20)
  customerName String?     @db.VarChar(100)
  totalAmount  Decimal     @db.Decimal(10, 2)
  notes        String?     @db.Text
  branchId     Int
  cashierId    Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  branch       Branch      @relation(fields: [branchId], references: [id])
  cashier      User        @relation(fields: [cashierId], references: [id])
  payment      Payment?
  inventoryAuditLogs InventoryAuditLog[]

  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  notes      String?  @db.VarChar(255)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model Payment {
  id          Int           @id @default(autoincrement())
  orderId     Int           @unique
  method      PaymentMethod
  amountPaid  Decimal       @db.Decimal(10, 2)
  change      Decimal       @default(0.00) @db.Decimal(10, 2)
  referenceNo String?       @db.VarChar(100)
  processedAt DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model AuthLog {
  id        Int            @id @default(autoincrement())
  userId    Int
  branchId  Int
  role      Role
  action    AuthLogAction
  ipAddress String?        @db.VarChar(45)
  userAgent String?        @db.VarChar(255)
  createdAt DateTime       @default(now())
  branch    Branch         @relation(fields: [branchId], references: [id])
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
  @@index([action])
  @@map("auth_logs")
}

model Ingredient {
  id                         Int                        @id @default(autoincrement())
  name                       String                     @unique @db.VarChar(150)
  category                   IngredientCategory
  unit                       InventoryUnit
  defaultConsumptionRateDays Int?
  defaultConsumptionLabel    String?                    @db.VarChar(100)
  defaultDailyDeduction      Decimal?                   @db.Decimal(12, 3)
  defaultPrice               Decimal?                   @db.Decimal(10, 2)
  defaultMinThreshold        Decimal?                   @db.Decimal(12, 3)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  inventory                  InventoryItem[]
  recipes                    MenuItemRecipeIngredient[]

  @@map("ingredients")
}

model InventoryItem {
  id                  Int                 @id @default(autoincrement())
  ingredientId        Int
  branchId            Int
  quantity            Decimal             @db.Decimal(12, 3)
  minThreshold        Decimal             @default(0.000) @db.Decimal(12, 3)
  price               Decimal?            @db.Decimal(10, 2)
  consumptionRateDays Int?
  consumptionLabel    String?             @db.VarChar(100)
  dailyDeductionAmount Decimal?           @db.Decimal(12, 3)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  ingredient          Ingredient          @relation(fields: [ingredientId], references: [id])
  branch              Branch              @relation(fields: [branchId], references: [id])
  auditLogs           InventoryAuditLog[]

  @@unique([branchId, ingredientId])
  @@index([branchId])
  @@index([ingredientId])
  @@index([isActive])
  @@map("inventory_items")
}

model MenuItemRecipeIngredient {
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Decimal    @db.Decimal(12, 3)
  createdAt    DateTime   @default(now())
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
  @@map("menu_item_recipes")
}

model InventoryAuditLog {
  id             Int                 @id @default(autoincrement())
  inventoryItemId Int
  actionType     InventoryActionType
  quantityBefore Decimal             @db.Decimal(12, 3)
  quantityAfter  Decimal             @db.Decimal(12, 3)
  quantityChanged Decimal            @db.Decimal(12, 3)
  note           String?             @db.VarChar(255)
  orderId        Int?
  actorUserId    Int?
  createdAt      DateTime            @default(now())
  inventoryItem  InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor          User?               @relation("InventoryAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([actionType])
  @@index([createdAt])
  @@index([orderId])
  @@map("inventory_audit_logs")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  CARD
}

enum AuthLogAction {
  LOGIN
  LOGOUT
}

enum IngredientCategory {
  SAUCE
  SPICES
  MAIN_INGREDIENT
  RICE
  UTILITIES
  GAS
}

enum InventoryUnit {
  ML
  GRAM
  LITER
  PCS
  GALLON
  TANK
  BAG
  PACK
  TUB
}

enum InventoryActionType {
  ORDER_DEDUCTION
  DAILY_DEDUCTION
  MANUAL_EDIT
}
